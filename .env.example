# Base URL of your n8n instance (no trailing slash, no /api/v1 suffix).
N8N_API_URL=https://your-n8n-instance.example.com

# n8n Public API key: n8n Settings -> API -> Create an API key.
N8N_API_KEY=your-n8n-api-key

# Optional. Instance-level MCP token: n8n Settings -> Instance-level MCP.
# Only needed for n8n_manage_agents / n8n_explore_node_resources.
# This is a SEPARATE secret from N8N_API_KEY.
N8N_MCP_ACCESS_TOKEN=

# Optional. n8n-mcp sends pseudonymous usage data (including workflow
# structures) to its maintainer. Defaults to disabled here; set to false
# to opt in.
N8N_MCP_TELEMETRY_DISABLED=true
